# Copy to .env for local runs (`npm start`, `npm run demo:ai`, `npm run test:live`).
# .env is git-ignored: never commit API keys. Variables set in the shell win over this file.

# Which model drives the simulated Alexa+: auto | openai | anthropic | bedrock | rules
#   auto (default): the first configured of openai, anthropic, bedrock; falls back to the
#   rules engine while that model can't be reached. The others never fall back.
ASSISTANT_ENGINE=anthropic

# Any Anthropic-compatible Messages API (tool use required). PetCheck appends /v1/messages.
# During development a relay (中转站) works well, e.g. ZenMux:
ANTHROPIC_BASE_URL=https://zenmux.ai/api/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-opus-5.5
# JSON merged into every request; replaces the default {"thinking":{"type":"disabled"}}.
# Claude Opus 5.5 can't turn thinking off, so keep effort low for a spoken reply:
ANTHROPIC_EXTRA_BODY='{"output_config":{"effort":"low"}}'
# Faster replies (about 4 s a turn instead of 6.6 s, all acceptance scenarios pass):
# ANTHROPIC_MODEL=anthropic/claude-haiku-5.5 and remove ANTHROPIC_EXTRA_BODY.
# Claude Sonnet 5.5 needs ANTHROPIC_EXTRA_BODY='{"thinking":{"type":"between_tools"}}'.

# Any OpenAI-compatible Chat Completions API (tool calling required).
OPENAI_BASE_URL=https://zenmux.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini
# JSON merged into every request. Qwen/DeepSeek on Alibaba Cloud think first by default, which
# triples the latency of a spoken turn: OPENAI_EXTRA_BODY='{"enable_thinking":false}'
# (not for api.openai.com, and glm-5.3 refuses it with HTTP 400).

# Amazon Bedrock (uses your AWS credentials).
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Per model call; a turn makes 2 or 3 calls and Lambda allows 30 s for the whole request.
# MODEL_TIMEOUT_MS=12000

# Where data lives: memory (default, fresh sample data each start), file (.data/, survives
# restarts; conversations too), or dynamodb (AWS).
# STORAGE=file
# DATA_FILE=.data/petcheck.jsonl

# The household's location for the care network when the device doesn't send one.
# HOME_LAT=42.2808
# HOME_LNG=-83.743
# HOME_LABEL=Ann Arbor, MI

# Local missed-task check interval in minutes (EventBridge does this on AWS); 0 turns it off.
# CHECK_EVERY_MIN=5
