# Copy to .env for local runs (`npm start`, `npm run demo:ai`, `npm run test:live`).
# .env is git-ignored: never commit API keys. Variables set in the shell win over this file.

# Which model drives the simulated Alexa+: auto | openai | anthropic | bedrock | rules
#   auto (default): the first configured of openai, anthropic, bedrock; falls back to the
#   rules engine while that model can't be reached. The others never fall back.
ASSISTANT_ENGINE=anthropic

# Any Anthropic-compatible Messages API (tool use required). PetCheck appends /v1/messages.
# During development a relay (中转站) works well, e.g. Code CLI:
ANTHROPIC_BASE_URL=https://code-cli.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# JSON merged into every request; replaces the default {"thinking":{"type":"disabled"}}. A spoken reply
# can't wait for long thinking: keep Opus at low effort. Claude Sonnet 5, Haiku 4.5 and Haiku 5.5 take the
# default; Claude Sonnet 5.5 needs {"thinking":{"type":"between_tools"}}.
ANTHROPIC_EXTRA_BODY='{"output_config":{"effort":"low"}}'

# Any OpenAI-compatible Chat Completions API (tool calling required). On Code CLI this side only offers
# GPT-5-and-later reasoning models, measured at about 29 s a turn: too slow for voice, so use the
# Anthropic protocol there (ASSISTANT_ENGINE=anthropic).
OPENAI_BASE_URL=https://code-cli.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# JSON merged into every request; a null removes a field. Reasoning models (GPT-5 and later) reject
# max_tokens and temperature:
OPENAI_EXTRA_BODY='{"max_tokens":null,"temperature":null,"max_completion_tokens":400,"reasoning_effort":"low"}'
# Qwen/DeepSeek on Alibaba Cloud think first by default, which triples the latency of a spoken turn:
# OPENAI_EXTRA_BODY='{"enable_thinking":false}' (glm-5.3 refuses it with HTTP 400).

# Amazon Bedrock (uses your AWS credentials).
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Per model call (default 12 s); a turn makes 2 or 3 calls and Lambda allows 30 s for the whole
# request. Slower relays need more locally:
# MODEL_TIMEOUT_MS=30000

# Where data lives: memory (default, fresh sample data each start), file (.data/, survives
# restarts; conversations too), or dynamodb (AWS).
# STORAGE=file
# DATA_FILE=.data/petcheck.jsonl

# The household's location for the care network when the device doesn't send one.
# HOME_LAT=42.2808
# HOME_LNG=-83.743
# HOME_LABEL=Ann Arbor, MI

# Local missed-task check interval in minutes (EventBridge does this on AWS); 0 turns it off.
# CHECK_EVERY_MIN=5
