# Copy to .env for local runs (`npm start`, `npm run demo:ai`, `npm run test:live`).
# .env is git-ignored: never commit API keys. Variables set in the shell win over this file.

# Which model drives the simulated Alexa+: auto | openai | anthropic | bedrock | rules
#   auto (default): the first configured of openai, anthropic, bedrock; falls back to the
#   rules engine while that model can't be reached. The others never fall back.
ASSISTANT_ENGINE=openai

# Any OpenAI-compatible Chat Completions API (tool calling required).
OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.8-max
# Extra JSON merged into every request. Qwen/DeepSeek here think first by default, which
# triples the latency of a spoken turn. Remove this line for api.openai.com, and for models
# that refuse it (glm-5.3 answers HTTP 400).
OPENAI_EXTRA_BODY='{"enable_thinking":false}'

# Any Anthropic-compatible Messages API (tool use required). PetCheck appends /v1/messages.
ANTHROPIC_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=qwen3.8-max

# Amazon Bedrock (uses your AWS credentials).
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Per model call; a turn makes 2 or 3 calls and Lambda allows 30 s for the whole request.
# MODEL_TIMEOUT_MS=12000
