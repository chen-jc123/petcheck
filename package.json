{
  "name": "petcheck",
  "version": "0.1.0",
  "description": "PetCheck: a shared pet care log for Alexa+, built as an MCP server (Streamable HTTP).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "smoke": "tsx test/smoke.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "dev:dynamo": "STORAGE=dynamodb tsx watch src/server.ts",
    "db:create": "tsx scripts/db.ts create",
    "db:reset": "tsx scripts/db.ts reset",
    "db:status": "tsx scripts/db.ts status",
    "test:storage": "tsx test/storage.ts",
    "build:lambda": "node scripts/build-lambda.mjs",
    "deploy": "bash scripts/deploy.sh",
    "logs": "aws logs tail /aws/lambda/petcheck-mcp --follow",
    "test:lambda": "tsx test/lambda.ts",
    "test:alerts": "tsx test/alerts.ts",
    "test:assistant": "tsx test/assistant.ts",
    "test:rules": "tsx test/rules.ts",
    "test:market": "tsx test/market.ts",
    "test:oauth": "tsx test/oauth.ts",
    "test:models": "tsx test/models.ts",
    "test:live": "tsx test/agent-live.ts",
    "check:listing": "node scripts/check-listing.mjs",
    "check:mcp": "bash scripts/check-mcp.sh",
    "demo": "ASSISTANT_ENGINE=rules DEMO_TODAY=1 tsx src/server.ts",
    "demo:ai": "DEMO_TODAY=1 tsx src/server.ts",
    "demo:video": "DEMO_TODAY=17:35 CHECK_EVERY_MIN=0 tsx src/server.ts",
    "db:demo": "tsx scripts/db.ts demo",
    "narration:polly": "bash scripts/make-narration-polly.sh",
    "test": "npm run -s smoke && npm run -s test:alerts && npm run -s test:storage && npm run -s test:lambda && npm run -s test:oauth && npm run -s test:assistant && npm run -s test:models && npm run -s test:rules && npm run -s test:market && npm run -s check:listing"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
